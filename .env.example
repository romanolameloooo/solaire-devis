# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Clé secrète « service_role » : serveur uniquement, ne jamais la partager
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Site ----
# Adresse publique du site (en local : http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Administration ----
# Votre email : seul ce compte peut ouvrir /admin (plusieurs emails séparés par des virgules)
ADMIN_EMAIL=vous@exemple.com

# ---- Abonnement ----
# Lien de paiement externe affiché quand l'essai est terminé (Wave, Orange Money, PayDunya…)
NEXT_PUBLIC_PAYMENT_LINK=
# Prix affiché sur la page d'accueil et l'écran d'abonnement
NEXT_PUBLIC_PRICE_LABEL=15 000 FCFA / mois
# Numéro WhatsApp où les clients vous préviennent après paiement (facultatif)
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ---- Mentions légales (pages Confidentialité et CGU) ----
# (facultatif : remplacent les valeurs de src/config/legal.ts)
NEXT_PUBLIC_LEGAL_EDITEUR=
NEXT_PUBLIC_LEGAL_STATUT=
NEXT_PUBLIC_LEGAL_IMMATRICULATION=
NEXT_PUBLIC_LEGAL_ADRESSE=
NEXT_PUBLIC_LEGAL_VILLE=
NEXT_PUBLIC_LEGAL_EMAIL=

# ---- Anti-spam (facultatif) : Cloudflare Turnstile ----
# Clé du site (publique). La clé secrète va dans Supabase > Authentication > Attack Protection, pas ici.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Mesure d'audience (facultatif) : Umami, gratuit et sans cookie ----
# Identifiant du site, dans https://cloud.umami.is > Settings > Websites
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
